# Generated from CLion C/C++ Code Style settings
---
Language: Cpp
BasedOnStyle: LLVM
AccessModifierOffset: -4

# Fixes schema expectations for modern Clang-Format
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignOperands: true
AlignTrailingComments: false

# Prevent short function bodies from being merged onto a single line.
# (Empty = only merge truly empty bodies; None = never merge anything.)
AllowShortFunctionsOnASingleLine: None

# Fixed: Changed unquoted 'Yes' to string literal to pass validation
AlwaysBreakTemplateDeclarations: "Yes"

BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

# Turn off horizontal alignment to the opening parenthesis
AlignAfterOpenBracket: false

# Disable packing of arguments into a single line
BinPackArguments: false

# Prevent all arguments from being placed on the next line as a group
AllowAllArgumentsOnNextLine: false

# Force parameters to drop to a new line if they exceed the column limit
BinPackParameters: "false"
# Ensures that if it wraps, it opens and closes parameters on their own lines
AllowAllParametersOfDeclarationOnNextLine: false

BreakBeforeBraces: Custom
BreakConstructorInitializers: AfterColon
BreakConstructorInitializersBeforeComma: false
ColumnLimit: 120
PointerAlignment: Left

# Fixed: Replaced deprecated names with modern schema-compliant flags
PackConstructorInitializers: Never
Cpp11BracedListStyle: false

ContinuationIndentWidth: 4
IncludeCategories:
  - Regex: '^<.*'
    Priority: 1
  - Regex: '^".*'
    Priority: 2
  - Regex: '.*'
    Priority: 3
IncludeIsMainRegex: '([-_](test|unittest))?$'
IndentCaseLabels: true
IndentWidth: 4
InsertNewlineAtEOF: true
MacroBlockBegin: ''
MacroBlockEnd: ''
MaxEmptyLinesToKeep: 2
NamespaceIndentation: All
SpaceAfterCStyleCast: true
SpaceAfterTemplateKeyword: false
SpaceBeforeRangeBasedForLoopColon: false
SpaceInEmptyParentheses: false
SpacesInAngles: false
SpacesInConditionalStatement: false
SpacesInCStyleCastParentheses: false
SpacesInParentheses: false
TabWidth: 4
...
